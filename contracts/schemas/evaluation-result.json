{
  "$defs": {
    "EvaluationCheck": {
      "additionalProperties": false,
      "description": "One rubric item. ``detail_ar``/``detail_en`` are learner-safe; ``diagnostic_code``\nis a stable internal code for support and analytics and is never shown to learners.",
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "detail_ar": {
          "minLength": 1,
          "title": "Detail Ar",
          "type": "string"
        },
        "detail_en": {
          "minLength": 1,
          "title": "Detail En",
          "type": "string"
        },
        "diagnostic_code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Diagnostic Code",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "check_id",
        "passed",
        "weight",
        "detail_ar",
        "detail_en",
        "diagnostic_code"
      ],
      "title": "EvaluationCheck",
      "type": "object"
    },
    "EvaluationError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "EvaluationError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/EvaluationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/EvaluationError"
      },
      "title": "Errors",
      "type": "array"
    },
    "evaluator_id": {
      "minLength": 1,
      "title": "Evaluator Id",
      "type": "string"
    },
    "evaluator_version": {
      "minLength": 1,
      "title": "Evaluator Version",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "summary_ar": {
      "title": "Summary Ar",
      "type": "string"
    },
    "summary_en": {
      "title": "Summary En",
      "type": "string"
    },
    "task_version_id": {
      "format": "uuid",
      "title": "Task Version Id",
      "type": "string"
    }
  },
  "required": [
    "evaluator_id",
    "evaluator_version",
    "task_version_id",
    "passed",
    "score",
    "checks",
    "errors",
    "summary_ar",
    "summary_en",
    "duration_ms"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
