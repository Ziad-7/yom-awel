          },
          "skill_id": {
            "minLength": 1,
            "title": "Skill Id",
            "type": "string"
          },
          "weight": {
            "minimum": 0.0,
            "title": "Weight",
            "type": "integer"
          }
        },
        "required": [
          "skill_id",
          "check_id",
          "weight"
        ],
        "title": "SkillMapping",
        "type": "object"
      },
      "SkillSummary": {
        "additionalProperties": false,
        "properties": {
          "score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          },
          "skill_id": {
            "minLength": 1,
            "title": "Skill Id",
            "type": "string"
          }
        },
        "required": [
          "skill_id",
          "score"
        ],
        "title": "SkillSummary",
        "type": "object"
      },
      "SkillsProfile": {
        "additionalProperties": false,
        "properties": {
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillSummary"
            },
            "title": "Skills",
            "type": "array"
          }
        },
        "required": [
          "learner_id",
          "skills"
        ],
        "title": "SkillsProfile",
        "type": "object"
      },
      "SubmissionInput": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "artifact_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Artifact Sha256",
            "type": "string"
          },
          "learner_note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Learner Note"
          },
          "task_version_id": {
            "format": "uuid",
            "title": "Task Version Id",
            "type": "string"
          }
        },
        "required": [
          "task_version_id",
          "artifact_id",
          "artifact_sha256"
        ],
        "title": "SubmissionInput",
        "type": "object"
      },
      "SubmissionOutcome": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "format": "uuid",
            "title": "Attempt Id",
            "type": "string"
          },
          "attempt_number": {
            "minimum": 1.0,
            "title": "Attempt Number",
            "type": "integer"
          },
          "evaluation": {
            "$ref": "#/components/schemas/EvaluationResult"
          },
          "feedback": {
            "$ref": "#/components/schemas/FeedbackResult"
          },
          "learner_status": {
            "$ref": "#/components/schemas/LearnerStatus"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillSummary"
            },
            "title": "Skills",
            "type": "array"
          },
          "submission_id": {
            "format": "uuid",
            "title": "Submission Id",
            "type": "string"
          },
          "task_status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "required": [
          "submission_id",
          "attempt_id",
          "attempt_number",
          "evaluation",
          "feedback",
          "learner_status",
          "task_status",
          "skills"
        ],
        "title": "SubmissionOutcome",
        "type": "object"
      },
      "SubmissionStatus": {
        "enum": [
          "RECEIVED",
          "EVALUATING",
          "COMPLETED",
          "FAILED"
        ],
        "title": "SubmissionStatus",
        "type": "string"
      },
      "TaskStatus": {
        "enum": [
          "AVAILABLE",
          "ACTIVE",
          "COMPLETED"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskVersion": {
        "additionalProperties": false,
        "properties": {
          "artifact_schema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Artifact Schema",
            "type": "object"
          },
          "content_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "evaluator_id": {
            "minLength": 1,
            "title": "Evaluator Id",
            "type": "string"
          },
          "evaluator_version": {
            "minLength": 1,
            "title": "Evaluator Version",
            "type": "string"
          },
          "instructions_ar": {
            "minLength": 1,
            "title": "Instructions Ar",
            "type": "string"
          },
          "instructions_en": {
            "minLength": 1,
            "title": "Instructions En",
            "type": "string"
          },
          "pass_threshold": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Pass Threshold",
            "type": "integer"
          },
          "skill_mappings": {
            "items": {
              "$ref": "#/components/schemas/SkillMapping"
            },
            "title": "Skill Mappings",
            "type": "array"
          },
          "task_id": {
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          },
          "task_version_id": {
            "format": "uuid",
            "title": "Task Version Id",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "task_version_id",
          "task_id",
          "version",
          "instructions_ar",
          "instructions_en",
          "artifact_schema",
          "evaluator_id",
          "evaluator_version",
          "pass_threshold",
          "skill_mappings",
          "content_hash"
        ],
        "title": "TaskVersion",
        "type": "object"
      },
      "UploadAuthorizationResult": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "upload_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Token"
          },
          "upload_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Url"
          }
        },
        "required": [
          "artifact_id",
          "expires_in_seconds"
        ],
        "title": "UploadAuthorizationResult",
        "type": "object"
      },
      "UploadCompletionResult": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          }
        },
        "required": [
          "artifact_id"
        ],
        "title": "UploadCompletionResult",
        "type": "object"
      },
      "UploadInput": {
        "additionalProperties": false,
        "properties": {
          "artifact_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Artifact Sha256",
            "type": "string"
          },
          "content_type": {
            "maxLength": 100,
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 5242880.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "size_bytes",
          "artifact_sha256",
          "content_type"
        ],
        "title": "UploadInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
