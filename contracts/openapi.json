            "minLength": 1,
            "title": "Persona Id",
            "type": "string"
          },
          "prompt_version": {
            "minLength": 1,
            "title": "Prompt Version",
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "used_fallback": {
            "title": "Used Fallback",
            "type": "boolean"
          }
        },
        "required": [
          "feedback_text",
          "language",
          "persona_id",
          "prompt_version",
          "provider",
          "model",
          "used_fallback",
          "duration_ms"
        ],
