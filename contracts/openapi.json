            "type": "string"
          }
        },
        "title": "HealthResult",
        "type": "object"
      },
      "JsonValue": {},
      "Language": {
        "enum": [
          "ar-EG",
          "en"
        ],
        "title": "Language",
        "type": "string"
      },
      "Learner": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "preferred_language": {
            "$ref": "#/components/schemas/Language"
          },
          "state_machine_version": {
            "default": "1",
            "minLength": 1,
            "title": "State Machine Version",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/LearnerStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "learner_id",
          "display_name",
          "preferred_language",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "Learner",
        "type": "object"
      },
      "LearnerStatus": {
        "enum": [
          "ONBOARDING",
          "READY",
          "IN_TASK",
          "PROCESSING",
          "NEEDS_RETRY",
          "TASK_COMPLETED",
          "PROGRAM_COMPLETED"
        ],
        "title": "LearnerStatus",
        "type": "string"
      },
      "OnboardInput": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Display Name",
            "type": "string"
          },
          "preferred_language": {
            "$ref": "#/components/schemas/Language",
            "default": "ar-EG"
          }
        },
        "required": [
