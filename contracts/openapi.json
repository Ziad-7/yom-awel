        ],
        "title": "OnboardInput",
        "type": "object"
      },
      "ProcessingState": {
        "additionalProperties": false,
        "properties": {
          "retry_after_seconds": {
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Retry After Seconds",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/SubmissionStatus"
          },
          "submission_id": {
            "format": "uuid",
            "title": "Submission Id",
            "type": "string"
          }
        },
        "required": [
          "submission_id",
          "status",
          "retry_after_seconds"
        ],
        "title": "ProcessingState",
        "type": "object"
      },
      "RuntimeResult": {
        "properties": {
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "simulated_evaluation": {
            "title": "Simulated Evaluation",
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "simulated_evaluation"
        ],
        "title": "RuntimeResult",
        "type": "object"
      },
      "SessionResult": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "default": 604800,
            "title": "Expires In",
            "type": "integer"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "SessionResult",
        "type": "object"
      },
      "SkillMapping": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "minLength": 1,
