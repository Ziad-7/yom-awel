            "format": "uuid",
            "title": "Submission Id",
            "type": "string"
          }
        },
        "required": [
          "submission_id",
          "attempt_number",
          "evaluation",
          "feedback"
        ],
        "title": "AttemptResult",
        "type": "object"
      },
      "CurrentTaskResult": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskVersion"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "title": "CurrentTaskResult",
        "type": "object"
      },
      "EvaluationCheck": {
        "additionalProperties": false,
