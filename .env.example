# Copy to .env (git-ignored) and fill in only what you need. Names only: never commit values.
# The local demo (demo/run_local.sh) needs none of these; it reads only the feedback variables.

# --- API (services/api) ---
# Runtime mode: local (SQLite and local files) or cloud.
APP_ENV=
# Cloud only: Postgres transaction pooler URI.
DATABASE_URL=
# Cloud only: session signing secret, at least 32 characters.
AUTH_SECRET=
# Comma-separated exact web app origins allowed by CORS.
CORS_ORIGINS=
# Optional: enables Gemini feedback; without it Tarek uses the deterministic fallback.
GEMINI_API_KEY=
# Optional: gemini-2.5-flash or gemini-2.5-flash-lite.
GEMINI_MODEL=
# Optional: auto (Gemini when a key is set) or fallback (always deterministic feedback).
FEEDBACK_MODE=
# Optional, not part of the demo: Telegram bot token.
TELEGRAM_BOT_TOKEN=
# Optional, not part of the demo: Telegram webhook verification secret.
TELEGRAM_WEBHOOK_SECRET=
# Local mode only: SQLite database path (default .local/learning.sqlite3).
LOCAL_DATABASE_PATH=
# Local mode only: path of the generated local session secret (default .local/session.key).
LOCAL_SECRET_PATH=

# --- Web (apps/web) ---
# Server-only: API origin the Next.js /api rewrite proxies to (default http://127.0.0.1:8000).
API_ORIGIN=
