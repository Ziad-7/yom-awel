# API only: local demo requires no cloud account.
APP_ENV=local
LOCAL_DATABASE_PATH=.local/learning.sqlite3
LOCAL_SECRET_PATH=.local/session.key
# Optional stable random secret, at least 32 characters. Never use a demo/test secret in cloud.
LOCAL_AUTH_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required for cloud; server-owned module:function returning real transport Services.
CLOUD_SERVICES_FACTORY=
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Browser-exposed values only (put in apps/web/.env.local).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
